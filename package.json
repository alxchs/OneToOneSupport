{
  "name": "onetoonesupport",
  "version": "1.0.0",
  "description": "Plataforma Desktop de Atendimento Remoto 1:1 Multimodal",
  "private": true,
  "main": "dist/electron/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-build-info.mjs && tsc -p tsconfig.electron.json && vite build && vite build --config vite.config.guest.ts",
    "build:guest": "vite build --config vite.config.guest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-runner.mjs",
    "rebuild": "electron-rebuild",
    "probe": "node tools/probe-runtime.cjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run probe"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "electron": "30.5.1",
    "express": "^4.21.2",
    "fabric": "^6.6.1",
    "libsodium-wrappers-sumo": "^0.7.15",
    "puppeteer": "^22.15.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sodium-native": "5.1.0",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
